@model ProductWebApp.Models.ProductModel

@{
    ViewData["Title"] = "Update A Product";
}

<hr />

<h3>Update Product</h3>
<hr />
<br />
<form asp-action="UpdateProduct" method="post">
    <div class="form-group">
        <label class="control-label" asp-for="Id"></label>
        <input class="form-control" type="text" asp-for="Id" value="@Model.Id" readonly />
    </div>
    <div class="form-group">
        <label class="control-label" asp-for="Name"></label>
        <input class="form-control" type="text" asp-for="Name" value="@Model.Name" />
    </div>
    <div class="form-group">
        <label class="control-label" asp-for="Price"></label>
        <input class="form-control" type="number" asp-for="Price" value="@Model.Price" />
    </div>
    <div class="form-group">
        <label class="control-label" asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="5" cols="10">
            @Model.Description
        </textarea>
    </div>
    <br />
    <div class="form-group" style="text-align:center">
        <input type="submit" value="Submit" class="btn btn-primary" />
    </div>
</form>

